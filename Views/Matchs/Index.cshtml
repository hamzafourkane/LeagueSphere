@model IEnumerable<Match>
@{
    ViewData["Title"] = "Calendrier";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold">📅 Calendrier des Matchs</h2>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary shadow">+ Nouveau Match</a>
        }
    </div>

    <div class="row">
        @foreach (var item in Model.OrderBy(m => m.DateMatch))
        {
            <div class="col-md-6 mb-4">
                <div class="card-custom text-center">
                    <div class="text-muted small mb-2">@item.DateMatch.ToString("dd MMMM yyyy - HH:mm")</div>

                    <div class="d-flex justify-content-around align-items-center">
                        <div class="text-center" style="width: 40%;">
                            <h4 class="fw-bold">@item.EquipeDomicile?.Nom</h4>
                        </div>

                        <div class="text-center">
                            @if (item.EstTermine)
                            {
                                <div class="score-badge">@item.ScoreDomicile - @item.ScoreExterieur</div>
                            }
                            else
                            {
                                <span class="badge bg-light text-dark border">VS</span>
                            }
                        </div>

                        <div class="text-center" style="width: 40%;">
                            <h4 class="fw-bold">@item.EquipeExterieur?.Nom</h4>
                        </div>
                    </div>

                    @if (User.IsInRole("Admin"))
                    {
                        <div class="mt-3">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Saisir Score / Modifier</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Supprimer</a>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
