@model Equipe

@{
    ViewData["Title"] = "Modifier l'équipe";
}

<div class="container mt-5 d-flex justify-content-center">
    <div class="col-md-6">
        <div class="card-custom">
            <h2 class="text-center mb-4">Modifier l'équipe</h2>

            <form asp-action="Edit">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Points" />
                <input type="hidden" asp-for="MatchsJoues" />
                <input type="hidden" asp-for="Victoires" />
                <input type="hidden" asp-for="Defaites" />
                <input type="hidden" asp-for="Nuls" />
                <input type="hidden" asp-for="ButsPour" />
                <input type="hidden" asp-for="ButsContre" />

                <div class="form-group mb-3">
                    <label asp-for="Nom" class="control-label fw-bold"></label>
                    <input asp-for="Nom" class="form-control" />
                    <span asp-validation-for="Nom" class="text-danger"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="LogoUrl" class="control-label fw-bold"></label>
                    <input asp-for="LogoUrl" class="form-control" />
                    <span asp-validation-for="LogoUrl" class="text-danger"></span>

                    @if (!string.IsNullOrEmpty(Model.LogoUrl))
                    {
                        <div class="mt-2 text-center">
                            <small>Logo actuel :</small><br />
                            <img src="@Model.LogoUrl" style="width: 60px; height: 60px; object-fit: cover; border-radius: 50%;" />
                        </div>
                    }
                </div>

                <div class="d-grid gap-2">
                    <input type="submit" value="Enregistrer les modifications" class="btn btn-primary" />
                    <a asp-action="Index" class="btn btn-secondary">Annuler</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
