@model IEnumerable<Equipe>

@{
    ViewData["Title"] = "Liste des Équipes";
}

<div class="container mt-5">

    <div class="card-custom">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 mb-0">🏆 Équipes en lice</h1>

            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fa fa-plus"></i> Nouvelle Équipe
                </a>
            }
        </div>

        <table class="table table-modern w-100">
            <thead>
                <tr>
                    <th>Logo</th>
                    <th>@Html.DisplayNameFor(model => model.Nom)</th>
                    <th class="text-center">Stats (V/N/D)</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="width: 80px;">
                            @if (!string.IsNullOrEmpty(item.LogoUrl))
                            {
                                <img src="@item.LogoUrl" alt="Logo" class="rounded-circle" style="width: 50px; height: 50px; object-fit: cover; border: 2px solid #fff; box-shadow: 0 2px 5px rgba(0,0,0,0.1);" />
                            }
                            else
                            {
                                <span class="badge bg-secondary">N/A</span>
                            }
                        </td>
                        <td class="fw-bold">
                            @Html.DisplayFor(modelItem => item.Nom)
                        </td>
                        <td class="text-center">
                            <span class="badge bg-success">@item.Victoires</span>
                            <span class="badge bg-warning text-dark">@item.Nuls</span>
                            <span class="badge bg-danger">@item.Defaites</span>
                        </td>
                        <td>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="text-primary me-3 text-decoration-none">✏️ Modifier</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="text-danger fw-bold text-decoration-none">🗑️ Supprimer</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
